#!/bin/bash
#PBS -N profdiag_gptoss
#PBS -P sbtabular.spons
#PBS -q standard
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=03:00:00
#PBS -j oe
#
# Proficiency diagnosis, gpt-oss-20b self-play (tutor AND student are the same
# served model -- see README: this is the self-play control, its score carries
# a shared-idiosyncrasy bonus and is not comparable to a cross-model run).
#
# Serves the model once on a local port and points both roles at it.
# Everything runs offline: the LeetCodeDataset was pre-fetched to the HF cache
# from the login node.

set -uo pipefail

source $HOME/miniconda3/etc/profile.d/conda.sh
conda activate mbppeval

export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1
export VLLM_USE_FLASHINFER_SAMPLER=0
export TOKENIZERS_PARALLELISM=false
# gpt-oss renders prompts through the harmony encoding, whose vocab openai_harmony
# fetches over the network on first use -- impossible on an offline compute node.
# Pre-populated from the login node; without this every chat completion 500s.
export TIKTOKEN_RS_CACHE_DIR=$HOME/harmony_cache

EXP=$HOME/yaksha_experiments/experiments/proficiency_diagnosis
OUT=${EXP}/results/gptoss_selfplay
mkdir -p "${OUT}"
exec > "${OUT}/job.log" 2>&1

MODEL=openai/gpt-oss-20b
SERVED=gptoss
PORT=$((8300 + RANDOM % 400))
BASE_URL="http://127.0.0.1:${PORT}/v1"

echo "########## profdiag gpt-oss-20b self-play on $(hostname) ##########"
echo "start: $(date)  port: ${PORT}"
nvidia-smi --query-gpu=name,memory.total --format=csv || true

# --- serve -----------------------------------------------------------------
vllm serve "${MODEL}" \
  --served-model-name "${SERVED}" \
  --port "${PORT}" \
  --tensor-parallel-size 1 \
  --max-model-len 16384 \
  --gpu-memory-utilization 0.90 \
  --seed 42 \
  > "${OUT}/vllm_server.log" 2>&1 &
VLLM_PID=$!
trap 'echo "shutting down vllm ${VLLM_PID}"; kill ${VLLM_PID} 2>/dev/null' EXIT

echo "waiting for vllm (pid ${VLLM_PID}) to come up..."
for i in $(seq 1 120); do   # up to ~20 min of loading
  if curl -s --max-time 5 "${BASE_URL}/models" | grep -q "${SERVED}"; then
    echo "server up after ${i} polls ($(date))"; break
  fi
  if ! kill -0 ${VLLM_PID} 2>/dev/null; then
    echo "FATAL: vllm died during startup; tail of its log:"; tail -40 "${OUT}/vllm_server.log"; exit 1
  fi
  sleep 10
done
curl -s --max-time 5 "${BASE_URL}/models" | grep -q "${SERVED}" || {
  echo "FATAL: server never became ready"; tail -40 "${OUT}/vllm_server.log"; exit 1; }

# /v1/models answering does NOT mean the model can generate: a missing harmony
# vocab leaves the model listed but every completion 500s. Probe the real
# endpoint before committing to a run.
echo "probing /v1/chat/completions ..."
PROBE=$(curl -s --max-time 120 "${BASE_URL}/chat/completions" \
  -H 'Content-Type: application/json' \
  -d "{\"model\":\"${SERVED}\",\"messages\":[{\"role\":\"user\",\"content\":\"Reply with the single word: ready\"}],\"max_tokens\":16}")
echo "probe response: ${PROBE:0:400}"
echo "${PROBE}" | grep -q '"choices"' || {
  echo "FATAL: chat completions endpoint is not functional (see probe response above)"
  tail -60 "${OUT}/vllm_server.log"; exit 1; }

cd "${EXP}"

COMMON_ARGS=(
  --tutor-model   "${SERVED}" --tutor-base-url   "${BASE_URL}"
  --student-model "${SERVED}" --student-base-url "${BASE_URL}"
  --reasoning-effort low
  --max-tokens 4096
  --difficulty Easy
)

# --- smoke: fail fast on format/serving problems before the 4000-call run ---
echo "=== SMOKE (3 profiles x 1 problem x 3 turns) $(date) ==="
python -u run_rollouts.py "${COMMON_ARGS[@]}" \
  --n-profiles 3 --problems 1 --turns 3 --concurrency 4 \
  --conditions interactive \
  --output "${OUT}/smoke_rollouts.jsonl" || { echo "FATAL: smoke rollout failed"; exit 1; }
python -u evaluate.py --rollouts "${OUT}/smoke_rollouts.jsonl" \
  --output "${OUT}/smoke_scores.jsonl" --summary "${OUT}/smoke_summary.json" \
  || { echo "FATAL: smoke evaluate failed"; exit 1; }

# NB: read this with an explicit default, never `x or 1.0` -- a parse_fail_rate
# of 0.0 is falsy in Python, so `or` turns a *perfect* smoke run into a fatal
# one. That bug cost a full GPU allocation once already.
SMOKE_FAIL=$(python -c "
import json; s=json.load(open('${OUT}/smoke_summary.json'))
if not s.get('n_episodes_scored'):
    print(1.0)                      # nothing scored at all -> treat as failure
else:
    v = s['by_condition'].get('interactive', {}).get('parse_fail_rate')
    print(round(1.0 if v is None else float(v), 3))")
echo "smoke parse_fail_rate=${SMOKE_FAIL}"
awk -v v="${SMOKE_FAIL}" 'BEGIN{exit !(v > 0.5)}' && {
  echo "FATAL: tutor is not producing parseable JSON (>50% of turns). Stopping"
  echo "before burning the full budget. Inspect ${OUT}/smoke_rollouts.jsonl."
  exit 1; }

# --- full run --------------------------------------------------------------
# 100 profiles x 2 problems x {interactive(17 calls), one_shot(2), blind(1)}
echo "=== FULL RUN $(date) ==="
python -u run_rollouts.py "${COMMON_ARGS[@]}" \
  --n-profiles 100 --problems 2 --turns 8 --concurrency 24 \
  --conditions interactive one_shot blind \
  --profile-seed 0 \
  --output "${OUT}/rollouts.jsonl"

echo "=== EVALUATE $(date) ==="
python -u evaluate.py --rollouts "${OUT}/rollouts.jsonl" \
  --output "${OUT}/episode_scores.jsonl" --summary "${OUT}/summary.json"

echo "########## DONE $(date) ##########"

# --- optional: hold the allocation after the work finishes ------------------
# Submit with `qsub -v HOLD_AFTER=1 run_gptoss_selfplay.pbs` to keep the GPU
# (and the vLLM server) alive until the walltime expires, instead of handing it
# back and re-queueing for hours. Release it early with:
#     touch <OUT>/RELEASE
# The server stays up, so you can point more experiments at it from a login
# node using the node IP + port printed below.
if [ "${HOLD_AFTER:-0}" = "1" ]; then
  NODE_IP=$(hostname -I | awk '{print $1}')
  echo "=== HOLDING allocation. vLLM still serving at http://${NODE_IP}:${PORT}/v1 (model: ${SERVED})"
  echo "=== release early with: touch ${OUT}/RELEASE"
  rm -f "${OUT}/RELEASE"
  while [ ! -f "${OUT}/RELEASE" ]; do
    if ! kill -0 ${VLLM_PID} 2>/dev/null; then echo "vllm died during hold; exiting"; break; fi
    sleep 60
  done
  echo "=== hold released at $(date)"
fi
