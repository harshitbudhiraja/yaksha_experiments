#!/bin/bash
#PBS -N net_probe2
#PBS -P sbtabular.spons
#PBS -q standard
#PBS -l select=1:ncpus=1:ngpus=1
#PBS -l walltime=00:08:00
#PBS -j oe
OUT=$HOME/yaksha_experiments/experiments/proficiency_diagnosis/results/net_probe2.log
exec > "$OUT" 2>&1
echo "=== probe2: authenticate the proxy FROM the compute node: $(hostname) $(date) ==="
# proxy.sh logs in to the campus proxy and then loops forever refreshing the
# session, so it must run in the background; it authorizes THIS node's IP.
nohup bash $HOME/proxy.sh > /tmp/proxy_$$.log 2>&1 &
PROXY_PID=$!
for i in $(seq 1 20); do
  grep -q "proxy login" /tmp/proxy_$$.log 2>/dev/null && { echo "proxy login OK after ${i} checks"; break; }
  sleep 3
done
head -5 /tmp/proxy_$$.log
export http_proxy=http://proxy21.iitd.ac.in:3128 https_proxy=http://proxy21.iitd.ac.in:3128
echo "--- openrouter models through authenticated proxy ---"
curl -s --max-time 40 -o /dev/null -w "models http=%{http_code}\n" https://openrouter.ai/api/v1/models
echo "--- real chat completion (gpt-oss-120b, tiny) ---"
curl -s --max-time 90 https://openrouter.ai/api/v1/chat/completions \
  -H "Authorization: Bearer $(cat $HOME/.openrouter_key)" \
  -H "Content-Type: application/json" \
  -d '{"model":"openai/gpt-oss-120b","messages":[{"role":"user","content":"Reply with one word: ready"}],"max_tokens":512}' \
  | head -c 600
echo
kill $PROXY_PID 2>/dev/null
echo "=== done $(date) ==="
